    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this clinic enquiry. Reply with VALID JSON only, no markdown, no code fences, no extra text:\n{\"category\":\"appointment|billing|medical_query|complaint|other\",\"urgency\":\"high|medium|low\",\"summary\":\"one short line\"}\ncategory: appointment=bookings, billing=payments/fees, medical_query=health questions, complaint=complaint, else other. urgency: high only if health risk or urgent.\nEnquiry: {{ $json.enquiry_text }}",
