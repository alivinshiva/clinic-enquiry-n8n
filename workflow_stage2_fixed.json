      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\n\nconst name = input.name;\nconst phone = input.phone ? String(input.phone) : '';\nconst email = input.email ? String(input.email) : '';\nconst enquiry = input.enquiry_text || input.enquiry || '';\n\nconst nameMissing = !name || name.toString().trim() === '';\nconst phoneDigits = phone.replace(/\\D/g, '');\nconst phoneValid = /^[6-9]\\d{9}$/.test(phoneDigits);\n\nconst errors = [];\nif (nameMissing) errors.push('Name is required.');\nif (phone === '') errors.push('Phone number is required.');\nelse if (!phoneValid) errors.push('Phone number must be a valid 10-digit Indian mobile number.');\n\nreturn {\n  json: {\n    name: name ? name.toString().trim() : '',\n    phone,\n    email,\n    enquiry_text: enquiry,\n    valid: errors.length === 0,\n    error_message: errors.join(' ')\n  }\n};"
      },
