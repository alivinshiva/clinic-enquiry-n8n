      "id": "71f4810d-997f-4181-a1e3-8cbbab2cbcf4",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "wxLFFSwF2pil1dDQ",
          "name": "Groq account"
        }
      }
