    {
      "parameters": {
        "jsCode": "const raw = String(\n  $json.output?.text ??\n  $json.message?.content ??\n  $json.response?.content ??\n  $json.content ??\n  $json.output ??\n  $json.text ??\n  ''\n);\n\nconst original = $('Code in JavaScript').first().json;\n\nconst fallback = {\n  category: 'other',\n  urgency: 'low',\n  summary: 'Could not classify: ' + raw.slice(0, 120),\n  parse_success: false\n};\n\ntry {\n  let text = raw.replace(/```(?:json)?\\s*/gi, '').replace(/```/g, '');\n  const start = text.indexOf('{');\n  const end = text.lastIndexOf('}');\n  if (start === -1 || end === -1 || end < start) {\n    return { json: { ...original, ...fallback, route: 'manual', ai_raw: text.slice(0, 500) } };\n  }\n  const parsed = JSON.parse(text.slice(start, end + 1));\n  const category = ['appointment', 'billing', 'medical_query', 'complaint', 'other']\n    .includes(String(parsed.category || '').toLowerCase())\n    ? String(parsed.category).toLowerCase()\n    : 'other';\n  const urgency = ['high', 'medium', 'low']\n    .includes(String(parsed.urgency || '').toLowerCase())\n    ? String(parsed.urgency).toLowerCase()\n    : 'low';\n  return {\n    json: {\n      ...original,\n      category,\n      urgency,\n      summary: String(parsed.summary || '').trim() || fallback.summary,\n      parse_success: true,\n      route: ['appointment', 'billing'].includes(category) ? 'auto' : 'manual'\n    }\n  };\n} catch (e) {\n  return { json: { ...original, ...fallback, route: 'manual', parse_error: e.message } };\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
